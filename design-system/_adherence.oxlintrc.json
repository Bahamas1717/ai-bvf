{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/bvf-app/**",
              "ui_kits/protocol/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|DM Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, DM Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevated|accent|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevated, accent, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GateBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|key|ref|className|style|children)$/]",
        "message": "<GateBadge> doesn't accept that prop. Declared props: status, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='GateBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pass|fail)$/]",
        "message": "<GateBadge> status must be one of 'pass' | 'fail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GateBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<GateBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|tone|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: label, value, sub, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|accelerate|fix|stop|neutral)$/]",
        "message": "<KpiCard> tone must be one of 'accent' | 'accelerate' | 'fix' | 'stop' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mirror'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|attribution|children|key|ref|className|style|children)$/]",
        "message": "<Mirror> doesn't accept that prop. Declared props: quote, attribution, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|score|threshold|tone|key|ref|className|style|children)$/]",
        "message": "<PillarMeter> doesn't accept that prop. Declared props: label, score, threshold, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillarMeter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accelerate|fix|stop|accent)$/]",
        "message": "<PillarMeter> tone must be one of 'accelerate' | 'fix' | 'stop' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScorecardCheck'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|verdict|score|pass|key|ref|className|style|children)$/]",
        "message": "<ScorecardCheck> doesn't accept that prop. Declared props: name, verdict, score, pass."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:verdict|size|children|key|ref|className|style|children)$/]",
        "message": "<VerdictBadge> doesn't accept that prop. Declared props: verdict, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<VerdictBadge> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
